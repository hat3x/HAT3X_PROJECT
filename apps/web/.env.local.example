# Supabase — get from Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dashboard password — MUST be a high-entropy random string
# Generate with: openssl rand -hex 32
DASHBOARD_TOKEN=your-random-token-here

# Note: The /api/dashboard/auth endpoint has no rate limiting.
# DASHBOARD_TOKEN must be a high-entropy random value (not a word/phrase).
# Recommended: openssl rand -hex 32
