# ─── HAT3X Demo Automator — Environment Variables ──────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Supabase (required) ────────────────────────────────────────────────────
# Project URL and anon key — safe for frontend (public by design)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ── AI Provider (at least one required for Edge Functions) ─────────────────
# Anthropic Claude — preferred provider
# Get your key at: https://console.anthropic.com/
# Set this in Supabase Dashboard → Settings → Edge Functions → Secrets
ANTHROPIC_API_KEY=sk-ant-...

# Lovable AI Gateway — fallback provider (used only if ANTHROPIC_API_KEY is unset)
# Only needed if you are deploying through Lovable's platform
LOVABLE_API_KEY=

# ── Supabase Edge Functions (set automatically by Supabase, do not change) ─
# These are available inside Edge Functions without manual configuration
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
