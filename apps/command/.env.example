# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HAT3X Command
HAT3X_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
HAT3X_DEFAULT_CONTROL_MODE=phased
OPENAI_API_KEY=sk-...
COMMAND_MODEL=gpt-5.2-codex

# Executor (Plan 12)
MAX_CONCURRENT_AGENTS=4
# Raíz de workspaces de clientes (default: ../../clients/projects)
HAT3X_REPOS_ROOT=
# Raíz de configs de agentes (default: ../../agents)
AGENTS_ROOT=
# Poner a 1 para correr los tests de integración contra Supabase vivo
HAT3X_TEST_LIVE=
