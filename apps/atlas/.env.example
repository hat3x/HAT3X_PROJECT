# Copia este fichero a .env.local y rellena los valores. .env.local NUNCA se
# commitea; este de aquí sí, pero solo con los nombres.
#
# Las Edge Functions no leen .env.local por su cuenta: en local hay que
# arrancarlas con `npx supabase functions serve --env-file .env.local`, y en
# producción los valores se cargan con `npx supabase secrets set`.

# ── Supabase propio de Atlas ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Llavero de credenciales ─────────────────────────────────────────────────
# 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde, las credenciales guardadas no se pueden descifrar. Si cambia,
# tampoco: no hay reencriptado automático.
ATLAS_MASTER_KEY=

# ── Enlaces firmados de «silenciar» ─────────────────────────────────────────
# Firma los enlaces que van dentro de las notificaciones, para poder silenciar
# una incidencia sin sesión. Mismo generador que la de arriba.
ATLAS_FIRMA_KEY=

# Dónde vive Atlas. Es la base de los enlaces que salen en las notificaciones:
# si apunta al puerto equivocado, se envían enlaces que no abren nada. En local
# es el 3010, el mismo que fija el script `dev`.
ATLAS_URL_PUBLICA=http://localhost:3010

# ── Avisos push ─────────────────────────────────────────────────────────────
# Generar el par con:
#   npx web-push generate-vapid-keys
#
# La pública va DOS VECES y con el MISMO valor, a propósito: el navegador solo
# ve las variables con prefijo NEXT_PUBLIC_, y las Edge Functions leen el nombre
# a secas. No es un secreto — su cometido es acabar en el navegador.
NEXT_PUBLIC_VAPID_PUBLICA=
VAPID_PUBLICA=
# Esta sí lo es: firma cada envío. Solo en el servidor.
VAPID_PRIVADA=
VAPID_CONTACTO=mailto:info@hat3x.com

# ── Quién vigila al vigilante ───────────────────────────────────────────────
# Si Supabase cae, el motor cae con él y Atlas se queda ciego SIN avisar de que
# está ciego: es el único fallo que no puede detectar por su cuenta. `vigia`
# hace ping a esta URL en cada pasada; si el ping deja de llegar, quien avisa es
# el servicio de fuera. Gratis en healthchecks.io y cinco minutos de alta.
# Vacío = sin latido, y todo lo demás sigue funcionando igual.
ATLAS_LATIDO_URL=

# ── Descubridor de tenants de Kairos ────────────────────────────────────────
# Lo único que autoriza `/api/descubrir`, la ruta que pg_cron despierta cada
# hora para reconciliar el censo de salones de Kairos. Quien la tenga puede dar
# de alta y pausar la vigilancia de cualquier cliente.
#
# Es un secreto PROPIO y no la service_role de Supabase, a propósito: la ruta
# vive en Vercel, y mandar la llave maestra de la base a un dominio de fuera en
# cada pasada amplía el radio de un descuido sin necesidad. Mismo generador que
# las de arriba.
#
# El mismo valor hay que dejarlo también en la base, que es quien lo manda:
#   alter database postgres set app.atlas_web_url  = 'https://…';
#   alter database postgres set app.atlas_cron_key = '<este valor>';
#
# El resto de la configuración —qué proyecto es Kairos, dónde está su Supabase y
# cuál es su clave— NO va aquí: vive en la propia base. Lo dice
# `src/lib/descubrir/ajustes.ts`, que explica qué falta cuando falta.
ATLAS_CRON_KEY=

# ── Avisos por correo ───────────────────────────────────────────────────────
# https://resend.com — sin esto los avisos por correo se registran como
# fallidos, con el motivo, y el push sigue funcionando igual.
RESEND_API_KEY=
