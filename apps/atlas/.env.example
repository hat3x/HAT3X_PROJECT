# Copia este fichero a .env.local y rellena los valores. .env.local NUNCA se
# commitea; este de aquí sí, pero solo con los nombres.
#
# Las Edge Functions no leen .env.local por su cuenta: en local hay que
# arrancarlas con `npx supabase functions serve --env-file .env.local`, y en
# producción los valores se cargan con `npx supabase secrets set`.

# ── Supabase propio de Atlas ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Llavero de credenciales ─────────────────────────────────────────────────
# 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde, las credenciales guardadas no se pueden descifrar. Si cambia,
# tampoco: no hay reencriptado automático.
ATLAS_MASTER_KEY=

# ── Enlaces firmados de «silenciar» ─────────────────────────────────────────
# Firma los enlaces que van dentro de las notificaciones, para poder silenciar
# una incidencia sin sesión. Mismo generador que la de arriba.
ATLAS_FIRMA_KEY=

# Dónde vive Atlas. Es la base de los enlaces que salen en las notificaciones:
# si apunta al puerto equivocado, se envían enlaces que no abren nada.
ATLAS_URL_PUBLICA=http://localhost:3000

# ── Avisos push ─────────────────────────────────────────────────────────────
# Generar el par con:
#   npx web-push generate-vapid-keys
#
# La pública va DOS VECES y con el MISMO valor, a propósito: el navegador solo
# ve las variables con prefijo NEXT_PUBLIC_, y las Edge Functions leen el nombre
# a secas. No es un secreto — su cometido es acabar en el navegador.
NEXT_PUBLIC_VAPID_PUBLICA=
VAPID_PUBLICA=
# Esta sí lo es: firma cada envío. Solo en el servidor.
VAPID_PRIVADA=
VAPID_CONTACTO=mailto:info@hat3x.com

# ── Avisos por correo ───────────────────────────────────────────────────────
# https://resend.com — sin esto los avisos por correo se registran como
# fallidos, con el motivo, y el push sigue funcionando igual.
RESEND_API_KEY=
