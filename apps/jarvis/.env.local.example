# OpenAI — Whisper STT
OPENAI_API_KEY=sk-...

# ElevenLabs — TTS
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# Jarvis model
JARVIS_MODEL=gpt-5.2

# HAT3X Command Server (run: cd apps/command && npm run server)
COMMAND_SERVER_URL=http://localhost:3002

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # anon key — safe to expose, used by Command dashboard
SUPABASE_SERVICE_ROLE_KEY=eyJ...       # service key — server-side only, never in browser
