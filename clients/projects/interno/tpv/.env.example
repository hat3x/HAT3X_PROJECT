# ============================================================================
# TPV · Variables de entorno de las Edge Functions de cobros
# ----------------------------------------------------------------------------
# Copia a `.env` (nunca lo subas). En Supabase, SUPABASE_URL y SUPABASE_ANON_KEY
# están inyectadas automáticamente en el runtime de Edge Functions; sólo se
# listan aquí para pruebas locales con `supabase functions serve`.
# ============================================================================

# URL del proyecto Supabase (https://<ref>.supabase.co).
SUPABASE_URL=

# Clave anónima (pública). Las funciones REENVÍAN el JWT del usuario para que la
# RLS por salón se aplique con el rol `authenticated`. NO se usa service_role.
SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# Sólo para la capa web (cliente). Prefijo según el bundler (VITE_ / NEXT_PUBLIC_).
# ----------------------------------------------------------------------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# NOTA — cobros, caja, facturación y reservas NO añaden variables de entorno.
# ----------------------------------------------------------------------------
# Todas las Edge Functions del TPV (tickets, pagos, caja, facturas, integración
# con reservas) usan ÚNICAMENTE SUPABASE_URL y SUPABASE_ANON_KEY de arriba.
#
# La configuración de FACTURACIÓN (serie por defecto y datos fiscales del emisor:
# razón social, NIF, dirección, pie legal, moneda) NO es una variable de entorno:
# vive por salón en la tabla `tpv_config_facturacion` (migración
# 20260713000003_tpv_facturacion) y se gestiona con SQL / panel de administración,
# no con `.env`. Así cada salón tiene su serie y sus datos sin redeploy.
