# ── Plantilla de variables de entorno ───────────────────────────────────
# Copia este archivo a `.env` y rellena los valores.
# Vite solo expone al cliente las variables con prefijo VITE_.

# ── Supabase — Base de datos de Salón OS ────────────────────────────────
# Todos los datos de la app de staff viven en la BD de Salón OS (multi-tenant).
VITE_SUPABASE_PROJECT_ID="jztoyekixcziaicrnlce"
VITE_SUPABASE_URL="https://jztoyekixcziaicrnlce.supabase.co"
# ANON KEY (role: anon) — pública. Cópiala desde salon-os/.env.local
# (NEXT_PUBLIC_SUPABASE_ANON_KEY) o desde el panel de Supabase → API.
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# ── Identidad del salón (Salón OS es multi-tenant) ──────────────────────
# El salón se resuelve EN RUNTIME (ver src/lib/salon.ts) con esta prioridad:
#   1) subdominio del host   (denueveanueve.salonos.app → "denueveanueve")
#   2) parámetro ?salon=<slug>
#   3) VITE_SALON_SLUG        (fallback, p. ej. en local/preview sin subdominio)
# Con ese slug se llama a la RPC pública get_salon_branding para obtener id, nombre,
# logo y colores; el salon_id EFECTIVO se DERIVA de ahí (no de VITE_SALON_ID).
#
# VITE_SALON_SLUG: slug de reserva cuando ni el subdominio ni ?salon= resuelven nada.
VITE_SALON_SLUG="denueveanueve"
# VITE_SALON_ID: OBSOLETO como fuente de verdad (el salon_id sale del salón resuelto).
# Se conserva solo como fallback documental del despliegue mono-salón.
VITE_SALON_ID="abeef620-4fe3-4b29-a17b-6c51a8284f8f"
