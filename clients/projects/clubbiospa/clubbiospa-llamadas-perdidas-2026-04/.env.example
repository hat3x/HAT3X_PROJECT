# ============================================================
# Club BioSpa — Automatización Llamadas Perdidas
# HAT3X | Proyecto: clubbiospa-llamadas-perdidas-2026-04
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env a control de versiones.
# ============================================================

# --- WEBHOOK ---
# URL base de tu instancia n8n (sin barra final)
N8N_BASE_URL=https://tu-instancia.n8n.cloud
# Path del webhook (debe coincidir con el nodo Webhook en n8n)
WEBHOOK_PATH=clubbiospa-llamada-perdida

# --- EMAIL SMTP (notificación por turno) ---
EMAIL_FROM=noreply@clubbiospa.com
# Turno encargado: 9:00 - 14:59
EMAIL_ENCARGADO=encargado@clubbiospa.com
# Turno jefe: 15:00 - 21:00
EMAIL_JEFE=jefe@clubbiospa.com
# Configura la credencial SMTP en n8n con estos datos:
# SMTP_HOST=smtp.gmail.com (o tu servidor)
# SMTP_PORT=587
# SMTP_USER=tu_usuario
# SMTP_PASS=tu_contraseña_de_app

# --- TWILIO (WhatsApp Business al cliente) ---
# Account SID de Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Auth Token de Twilio
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Número de Twilio con WhatsApp habilitado (formato: +34XXXXXXXXX)
TWILIO_WHATSAPP_FROM=+14155238886
# NOTA: En producción usa el número de negocio aprobado por Meta/Twilio.
# En sandbox usa: +14155238886 (número Twilio Sandbox)

# --- TELEGRAM BOT (alerta inmediata por turno) ---
# Token del bot de Telegram (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Chat ID del encargado (turno 9:00-14:59)
TELEGRAM_CHAT_ID_ENCARGADO=-1001234567890
# Chat ID del jefe (turno 15:00-21:00)
TELEGRAM_CHAT_ID_JEFE=-1009876543210
# NOTA: Para obtener el Chat ID, añade el bot al chat/grupo y visita:
# https://api.telegram.org/bot<TOKEN>/getUpdates

# --- RETELL AI (recepcionista IA de voz) ---
# Clave de API de Retell AI
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID del agente creado en Retell dashboard
RETELL_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Número de teléfono asignado al agente en Retell (+34XXXXXXXXX)
RETELL_PHONE_NUMBER=+34900000000
# Secret para validar la firma HMAC del webhook de Retell
RETELL_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# --- ELEVENLABS (voz del recepcionista IA) ---
# Clave de API de ElevenLabs
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Voice ID de la voz seleccionada (Laura — recomendada para Club BioSpa)
# Ver docs/elevenlabs-config.md para alternativas y proceso de aprobación
ELEVENLABS_VOICE_ID=FGY2WhTYIju1LtPQGaGP
# Modelo de síntesis de voz (eleven_turbo_v2_5 para menor latencia en llamadas)
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- HORARIO DE ATENCIÓN (referencia — se configura en Retell AI) ---
# Estos valores son informativos. La lógica de horario la gestiona Retell AI
# antes de disparar el webhook. El campo `fuera_de_horario` viene en el payload.
# HORARIO_APERTURA=09:00
# HORARIO_CIERRE=20:00
# ZONA_HORARIA=Europe/Madrid
# DIAS_ATENCION=lunes,martes,miercoles,jueves,viernes,sabado
