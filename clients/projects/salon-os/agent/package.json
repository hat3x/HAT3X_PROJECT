{
  "name": "salon-os-imaging-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Puente local entre el equipo de rayos de la clínica y Salón OS. Corre en el PC de la clínica; no guarda credenciales.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:instalador": "node scripts/empaquetar.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
