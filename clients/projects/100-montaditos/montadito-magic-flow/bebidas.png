    margin:2px;
    position: relative;
}

.cm-icon__aler{
    display: inline-block;
    position: relative;
    vertical-align: middle;
    border: none;
    width: 30px;
    height: 30px;
}

.cm-icon__aler:after{
    content:"";
    display:block;
    position:absolute;
    top:0;
    left:0;
    width: 30px;
    height: 30px;
    
    background-size: contain;
    background-position:center;
    z-index: 10;
}
.cm-icon__aler-apio:after {
    background-image:url('/assets/web/images/origin/2021/Abril/aler_apio.png');
}
