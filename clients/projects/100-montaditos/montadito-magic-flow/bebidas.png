                            <img src="/assets/web/img/gmo.png" alt="sin gmo">
                            <small>Sin GMO</small>
                        </span>
                        <span class="d-flex flex-column  flex-center">
                            <img src="/assets/web/img/colesterol.png" alt="0% colesterol">
