body .cm-logo svg,
body .cm-logo svg path,
body .cm-menu__languages-item { 
    fill: white !important;
    color: white !important;
    transition: all 0.3s ease;
    position: relative;
    z-index: 10000;
}

body #ca-button--open svg line {
    stroke: white !important;
    transition: all 0.3s ease;
}
body.header-passed .cm-logo svg,
body.header-passed .cm-logo svg path,
body.header-passed .cm-menu__languages-item { 
    fill: black !important;
    color: black !important;
}

body.header-passed #ca-button--open svg line {
    stroke: black !important;
}
.cm-menu__languages.is-active .cm-menu__languages-item {
    color: black !important;
}
:has(.cm-menu__languages.is-active) .cm-logo svg,
:has(.cm-menu__languages.is-active) .cm-logo svg path {
    fill: black !important;
    color: black !important;
}
:has(.cm-menu__languages.is-active) #ca-button--open svg line {
    stroke: black !important;
}
.cm-menu__languages.is-active ~ #ca-button--close svg path {
    fill: black !important;
}



.carta-row,
.carta-row-end {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  padding-top: 50px;
  gap: 50px 0;
}

.card-carta {
  width: 25%;
  min-width: 325px;
  border-radius: 3rem;
  overflow: visible;
  padding-top: 60px;
  text-align: center;
}

.carta-img-red-promo {
  width: 60%;
  border-radius: 3rem;
}

.carta-img-red,
.carta-img-red-promo {
  background-color: var(--red);
}

.card-carta.carta-img-red-promo img {
  max-width: 100%;
}

.carta-img-light-green {
  background-color: #8ab3adc9
}

.carta-img-green {
  background-color: #106b40d4;
}

.carta-img-light-blue {
  background-color: #5f8dadb0;
}

.carta-img-light-orange {
  background-color: #cf7555c9;
}

.carta-img-orange {
  background-color: #cf7555f7;
}

.carta-img-bold-green {
  background-color: #053920;
}

.card-carta img {
  max-width: 105%;
  margin-top: 40px;
  margin-left: -10px;
  transform: translateY(-20px);
  transition: transform 0.3s ease;
  z-index: 2;
  position: relative;
}

.card-carta:hover img {
  transform: translateY(-30px) scale(1.05);
}

.title-card {
  font-family: 'Poppins', sans-serif;
  font-size: 3rem;
  font-weight: 900;
  color: white;
}

.title-card-green {
  font-size: 3rem;
  color: #074929;
  font-weight: 100;
}

.title-card-green-bold {
  font-family: 'Poppins', sans-serif;
  font-size: 3rem;
  color: #074929;
  font-weight: 900;
}

footer {
    margin-top: 160px;
}
