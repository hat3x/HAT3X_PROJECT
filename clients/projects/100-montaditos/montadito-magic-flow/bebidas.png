            <script>
        document.addEventListener("DOMContentLoaded",function(e){
    let element100m= document.getElementById("ca-down");
    let carouselHome = document.getElementById("cm-carousel__container");
    let elementButtons = document.querySelectorAll(".ca-carta");

    let header = document.querySelector('.cm-header');
    let body = document.body;

    if (header) {
        function checkHeaderScroll() {
            let headerHeight = header.offsetHeight;
            let scrollPosition = window.scrollY;

            if (scrollPosition > (headerHeight - 50)) {
                body.classList.add('header-passed');
            } else {
                body.classList.remove('header-passed');
            }
        }

        checkHeaderScroll();

        window.addEventListener('scroll', checkHeaderScroll);
    }

    if (elementButtons[0]) {
        for(const el in Array.from(elementButtons)){
            elementButtons[el].addEventListener("click",cm.clickActionToCarta, false);
            }
    }

   if (element100m) {
         element100m.addEventListener("click",function(e){
             e.preventDefault();
             let el=document.getElementById("carta")
             cm.scrolldown(el);
        },false);      
    }

    if (carouselHome) {
        cm.initCarouselPromotions("cm-carousel");
    }

    let elementForm = document.getElementById("newsletter");
    if (elementForm) {
        Form.type="newsletter";
        Form.init(elementForm);
    }
});

window.addEventListener("load",(e)=>{
   if(typeof mediaModal == "function"){
   //   mediaModal("https://www.youtube.com/embed/pMfNlwagK_A?autoplay=1&mute=1&enablejsapi=1","iframe");
   }
});
        </script>
    


