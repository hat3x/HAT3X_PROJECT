            <div class="content-field max-600 pad-10">
                <label for="accept-legal" class="mb-10">
                    <input id="accept-legal" data-send="accept-legal" name="accept-legal" type="checkbox" class="checkbox-style data-send" required="">
                    He leído y acepto la <a href="/es/politica-privacidad" target="blank" class="text-underline">Política de
                            Privacidad</a>
                </label>
            </div>
            <div class="content-field max-600 pad-10">
                <label for="notificate-promotion" class="mb-10">
                    <input id="notificate-promotion" name="notificate-promotion" data-send="notificate-promotion" type="checkbox" class="checkbox-style data-send">
                    Acepto recibir información de promociones y descuentos
                </label>
