/*style nav carta*/
     .link-carta{
        position: relative;
        margin-top:150px;
    }
    .link-carta__container {
        position: relative;
        display:flex;
        width: 100%;
        gap:10px;
    }
    .link-carta__item {
        position: relative;
        transition: all 0.3s ease;
        text-align:center;
    }
    .link-carta__image{
        position: relative;
        display: block;
        height: 120px;
        background-color: var(--cc-bg);
        border-radius: 25px;
        padding: 0px 10px;
        transition: all 0.3s ease;
    }
    .link-carta__image img{
        position: relative;
        display: block;
        width: 100%;
        object-fit: contain;
        aspect-ratio: 4 / 3;
    }
    .link-carta__item.is-active .link-carta__image{
        background-color: #ffa7a7;
    }
    .link-carta__image:hover{
        opacity: 0.5;
    }

    @media(max-width:1199px){
        .link-carta__container {
            width: 950px;
        }
        .link-carta{
            overflow-x: auto;
        }
        .link-carta__item {
            width:150px;
        }
        .link-carta__image{
            height: 100px;
        }
    }
    @media(max-width:1199px){
        .link-carta__container {
            padding-right:30px;
            margin-left:50px;
        }
    }
/*endstyle nav carta*/
