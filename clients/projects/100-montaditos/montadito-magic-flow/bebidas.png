.cm-help__close {
     display:block;
    position:fixed;
    right:95px;
    font-size:20px;
    bottom:105px;
    border:initial;
    outline:transparent;
    background-color:transparent;
     transition:all .2s linear;
}
.cm-help__close:hover {
    opacity:.5;
    cursor:pointer
}
.cm-help__image {
    display:block;
    width:70px;
    height:70px;
    position:relative;
    border-radius: 50%;
}
.cm-help__image img {
    display:block;
    object-fit:cover;
    width:100%;
    object-position:center;
}
.cm-list__icons img{
    display: flex;
