# ─────────────────────────────────────────────────────────────────────
# denueveanueve · plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores marcados con <...>.
# NUNCA subas el `.env` real: está en .gitignore (sólo se versiona este .example).
# ─────────────────────────────────────────────────────────────────────

# ── Supabase · Salón OS ───────────────────────────────────────────────
# Proyecto: salon-os (org HAT3X) — jztoyekixcziaicrnlce
VITE_SUPABASE_URL="https://jztoyekixcziaicrnlce.supabase.co"
VITE_SUPABASE_PROJECT_ID="jztoyekixcziaicrnlce"
# Anon / publishable key (pública, pero rellénala desde el panel de Supabase)
VITE_SUPABASE_PUBLISHABLE_KEY="<supabase-anon-key>"

# ── Salón OS · Identificación del salón ───────────────────────────────
# El salón se resuelve en RUNTIME (subdominio del host > ?salon=<slug> >
# VITE_SALON_SLUG) y su `id` (salon_id) se DERIVA del branding que devuelve la
# RPC get_salon_branding. VITE_SALON_SLUG es sólo el FALLBACK cuando el host no
# trae subdominio y no hay ?salon (p. ej. en localhost/dev).
VITE_SALON_SLUG="denueveanueve"
# VITE_SALON_ID ya NO se usa para derivar salon_id (se mantiene sólo como
# referencia histórica; puede eliminarse).
VITE_SALON_ID="abeef620-4fe3-4b29-a17b-6c51a8284f8f"

# ── Stripe (frontend) ─────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY="<stripe-publishable-key>"

# ── Claves de servidor · Edge Functions (NUNCA en el bundle del cliente) ─
SUPABASE_ANON_KEY="<supabase-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"
SUPABASE_API_TOKEN="<supabase-api-token>"
API_KEY_APP_DENUEVEANUEVE="<app-api-key>"
