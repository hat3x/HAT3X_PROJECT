# ── Supabase ──────────────────────────────────────────────────────────
# Panel: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor (NUNCA exponer con NEXT_PUBLIC_). Necesaria para tareas
# administrativas / Edge Functions. No requerida para el auth básico.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────────────
# URL base de la app (usada en redirects de auth). En local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── WhatsApp / Twilio ─────────────────────────────────────────────────
# Todos los valores son placeholders. Mientras alguno sea placeholder
# o WHATSAPP_REMINDERS_ENABLED != 'true', NO se envía ningún mensaje
# (el sistema opera en dry-run y solo imprime logs en consola).
#
# Pasos para activar:
#  1. Crea una cuenta en https://www.twilio.com
#  2. Aprueba las plantillas en el Content Template Builder de Twilio
#     (requiere aprobación de Meta, ~24-48 h en negocio verificado)
#  3. Sustituye los placeholders con los valores reales
#  4. Cambia WHATSAPP_REMINDERS_ENABLED a 'true'
#
# Panel Twilio: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Número WhatsApp emisor en formato E.164 (sin el prefijo whatsapp:)
# Panel: Twilio Console → Messaging → Senders → WhatsApp Senders
TWILIO_WHATSAPP_FROM=+34600000000

# ContentSid de cada plantilla aprobada (Content Template Builder)
# Formato: HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID_RECORDATORIO_24H=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID_RECORDATORIO_2H=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID_CONFIRMACION=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID_CANCELACION=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID_SEGUIMIENTO=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL de callback de estado de entrega (opcional, para webhooks de Twilio)
# TWILIO_STATUS_CALLBACK_URL=https://your-domain.com/api/webhooks/twilio/status

# Kill-switch global. Cambiar a 'true' SOLO cuando las credenciales sean reales
# y las plantillas estén aprobadas por Meta.
WHATSAPP_REMINDERS_ENABLED=false

# ── Cron de recordatorios ─────────────────────────────────────────────────────
# Secreto compartido entre el cron (Vercel o pg_cron) y la Edge Function.
# Generar con: openssl rand -hex 32
# En Vercel: añadir también como variable en el proyecto (Project Settings → Env Vars).
CRON_SECRET=your-cron-secret-here
