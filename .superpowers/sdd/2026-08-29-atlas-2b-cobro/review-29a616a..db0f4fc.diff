+    await registrar(sb, p.id, null, "email", rc.ok, rc.error, "cobro");
+    if (rc.ok) enviados++;
+  }
+
+  return new Response(JSON.stringify({ enviados, noComprobados }), {
+    headers: { "content-type": "application/json" },
   });
 }
