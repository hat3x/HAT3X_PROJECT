+              </thead>
+              <tbody className="divide-y" style={{ borderColor: "var(--cristal-borde)" }}>
+                {c.vencidas.map((f) => {
+                  // Sin `!`: `f.fechaVencimiento` ya es `string` en el tipo —
+                  // `pendientesDeCobro` estrecha `vencidas` porque su propio
