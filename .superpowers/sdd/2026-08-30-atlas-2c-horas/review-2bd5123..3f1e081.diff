+    if (idProyecto !== "") {
+      try {
+        await pg.query(`DELETE FROM proyectos WHERE id = $1`, [idProyecto]);
+      } catch {
+        /* ya no está */
+      }
+    }
+    if (idCliente !== "") {
+      try {
+        await pg.query(`DELETE FROM clientes WHERE id = $1`, [idCliente]);
+      } catch {
+        /* ya no está */
+      }
+    }
+  } finally {
+    await pg.end();
+  }
+});
+
+describe("validarTramo", () => {
