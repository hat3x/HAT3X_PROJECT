+    [SLUG_CLIENTE]
+  );
+  idCliente = cl.rows[0].id;
+});
+
+beforeEach(async () => {
+  for (const id of [idDuenyo, idColab]) {
+    if (id !== "") await pg.query(`DELETE FROM fichajes WHERE usuario_id = $1`, [id]);
+  }
+});
+
+afterAll(async () => {
+  try {
+    for (const id of [idDuenyo, idColab]) {
