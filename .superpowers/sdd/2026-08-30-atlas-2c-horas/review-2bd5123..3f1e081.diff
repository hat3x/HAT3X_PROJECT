+
+describe("fichar", () => {
+  it("empezar deja uno en curso, con su proyecto y su cliente", async () => {
+    const r = await empezar(sbDuenyo, { proyectoId: idProyecto, clienteId: idCliente, nota: null });
+    expect(r).toEqual({ ok: true });
