+          ctx.addIssue({
+            code: z.ZodIssueCode.custom,
+            message: "Los tramos de un mismo día no pueden solaparse",
+            path: ["slots", currentSlot.index, "start_time"],
+          });
+        }
+      }
+    }
+  });
+
