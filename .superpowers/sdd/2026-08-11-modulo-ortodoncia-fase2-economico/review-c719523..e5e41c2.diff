+        <Card>
+          <CardContent className="py-10 text-center text-sm text-muted-foreground">
+            No tienes una clínica asignada.
+          </CardContent>
+        </Card>
+      ) : !hasPatient ? (
+        <PatientSelector
+          salonId={salonId}
+          hrefBase="/ortodoncia"
+          purposeLabel="ver su ortodoncia"
+        />
